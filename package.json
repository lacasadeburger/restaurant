{
  "name": "restaurante",
  "private": true,
  "homepage": "https://lacasadeburger.es/",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "rimraf dist",
    "build": "npm run clean && vite build",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "predeploy": "npm run build && echo lacasadeburger.es > ./dist/CNAME",
    "deploy": "gh-pages -d dist",
    "ovh-deploy": "npm run build && node deploy.js",
    "ship": "npm run build && git add . && git commit -m \"Performance: Optimized chunks and LCP\" && git push origin main && node deploy.js"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "gh-pages": "^6.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-stripe-checkout": "^2.6.3",
    "sweetalert2": "^11.7.16"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react-swc": "^3.0.0",
    "eslint": "^8.38.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "ftp-deploy": "^2.4.7",
    "rimraf": "^6.1.3",
    "terser": "^5.46.0",
    "vite": "^4.3.2"
  }
}
