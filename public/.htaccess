# ----------------------------------------------------------------------
# 1. RÉGLAGES SERVEUR & SÉCURITÉ
# ----------------------------------------------------------------------
RewriteEngine On
Options -Indexes

Header set X-Frame-Options "SAMEORIGIN"
Header set X-XSS-Protection "1; mode=block"
Header set X-Content-Type-Options "nosniff"

# 2. REDIRECTION HTTPS (Optimisée)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 3. COMPRESSION GZIP (On exclut les images déjà compressées pour libérer le CPU)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/wasm
    AddOutputFilterByType DEFLATE font/woff font/woff2 image/svg+xml image/x-icon

    # Sécurité pour les vieux navigateurs
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# 4. CACHE NAVIGATEUR (Expires + Cache-Control pour PageSpeed)
<IfModule mod_expires.c>
    ExpiresActive On

    # Par défaut, on ne cache pas (sécurité pour le HTML)
    ExpiresDefault "access plus 0 seconds"

    # Assets avec Hash (1 an) - Très sûr grâce à Vite
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    # Images (1 an)
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    # On force le Header Cache-Control pour PageSpeed
    # On ajoute "no-cache" spécifiquement pour l'index.html
    <FilesMatch "\.(css|js|woff2|jpg|jpeg|png|webp|ico|svg)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    <FilesMatch "\.(html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# 5. GESTION DES ERREURS
ErrorDocument 404 /index.html

# 6. ROUTAGE REACT (INDISPENSABLE)
RewriteBase /
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
